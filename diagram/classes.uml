@startuml

!theme plain

skinparam linetype ortho

skinparam classRoundCorner 0
skinparam classBorderThickness 2
skinparam classFontName "Times New Roman"
skinparam classFontSize 14
skinparam classFontStyle normal
skinparam classFontColor black
skinparam classAttributeIconSize 0
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classArrowColor black
skinparam classAbstractFontStyle italic
skinparam classAbstractFontColor black
skinparam classAbstractUnderline true
skinparam inheritanceArrowColor black

hide circle

' ===== Базовый класс =====
abstract class Person {
  - firstName : std::string
  - lastName  : std::string
  --
  + getFirstName() : std::string
  + getLastName() : std::string
  + getFullName() : std::string
  + setFirstName(firstName : std::string) : void
  + setLastName(lastName : std::string) : void
  + displayInfo() : void
}

' ===== Сотрудники =====
class Employee {
  # employeeId   : int
  # departmentId : int
  # salary       : double
  --
  + getEmployeeId() : int
  + getDepartmentId() : int
  + getSalary() : double
  + setEmployeeId(employeeId : int) : void
  + setDepartmentId(departmentId : int) : void
  + setSalary(salary : double) : void
  + displayInfo() : void
  + calculateTotalIncome() : double
}

class Manager {
  - subordinates : std::vector<int>
  --
  + addSubordinate(subordinateId : int) : void
  + removeSubordinate(subordinateId : int) : void
  + getSubordinates() : std::vector<int>
  + getSubordinatesCount() : int
  + hasSubordinate(subordinateId : int) : bool
  + displayInfo() : void
  + calculateTotalIncome() : double
}

class Worker {
  - positionId : int
  - bonus      : double
  --
  + getPositionId() : int
  + getBonus() : double
  + setPositionId(positionId : int) : void
  + setBonus(bonus : double) : void
  + displayInfo() : void
  + calculateTotalIncome() : double
}

' ===== Отдел, должность, дата найма =====
class Department {
  - departmentId   : int
  - departmentName : std::string
  - managerId      : int
  - employees      : std::vector<int>
  --
  + getDepartmentId() : int
  + getDepartmentName() : std::string
  + getManagerId() : int
  + getEmployees() : std::vector<int>
  + getEmployeesCount() : int
  + setDepartmentId(departmentId : int) : void
  + setDepartmentName(departmentName : std::string) : void
  + setManagerId(managerId : int) : void
  + addEmployee(employeeId : int) : void
  + removeEmployee(employeeId : int) : void
  + hasEmployee(employeeId : int) : bool
  + displayInfo() : void
}

class Position {
  - positionId      : int
  - positionName    : std::string
  - workHoursPerWeek: int
  --
  + getPositionId() : int
  + getPositionName() : std::string
  + getWorkHoursPerWeek() : int
  + setPositionId(positionId : int) : void
  + setPositionName(positionName : std::string) : void
  + setWorkHoursPerWeek(workHoursPerWeek : int) : void
  + displayInfo() : void
}

class HireDate {
  - employeeId : int
  - day        : int
  - month      : int
  - year       : int
  - hour       : int
  - minute     : int
  --
  + getEmployeeId() : int
  + getDay() : int
  + getMonth() : int
  + getYear() : int
  + getHour() : int
  + getMinute() : int
  + setEmployeeId(employeeId : int) : void
  + setDay(day : int) : void
  + setMonth(month : int) : void
  + setYear(year : int) : void
  + setHour(hour : int) : void
  + setMinute(minute : int) : void
  + getDateString() : std::string
  + getTimeString() : std::string
  + getFullDateTimeString() : std::string
  + displayInfo() : void
}

' ===== Вспомогательные структуры =====
class EmployeeRecord {
  + employee : std::shared_ptr<Employee>
  + hireDate : HireDate
}

class EmployeeSearchFilter {
  + useDepartmentId : bool
  + departmentId    : int
  + usePositionId   : bool
  + positionId      : int
  + useMinSalary    : bool
  + minSalary       : double
  + useMaxSalary    : bool
  + maxSalary       : double
  + useNameFragment : bool
  + nameFragment    : std::string
}

enum EmployeeSortKey {
  ById
  ByDepartment
  BySalary
  ByLastName
  ByHireDate
}

class UndoCommand {
  + undo        : std::function<void()>
  + description : std::string
}

' ===== Обобщённый контейнер =====
class "RecordCollection<T>" as RecordCollectionT {
  - records : std::vector<T>
  --
  + size() : std::size_t
  + empty() : bool
  + reserve(capacity : std::size_t) : void
  + add(value : T) : void
  + at(index : std::size_t) : T&
  + clear() : void
  + data() : std::vector<T>&
  + findIf(predicate) : Iterator
  + removeIf(predicate) : void
  + insertionSort(compare) : void
  + forEach(fn) : void
}

' ===== DataManager =====
class DataManager {
  - employeesPath   : std::string
  - departmentsPath : std::string
  - positionsPath   : std::string
  - hiresPath       : std::string
  --
  - employees   : RecordCollection<EmployeeRecord>
  - departments : RecordCollection<Department>
  - positions   : RecordCollection<Position>
  - employeeIndex   : std::unordered_map<int,std::size_t>
  - departmentIndex : std::unordered_map<int,std::size_t>
  - positionIndex   : std::unordered_map<int,std::size_t>
  - undoStack       : std::vector<UndoCommand>
  - undoInProgress  : bool
  - nextEmployeeId   : int
  - nextDepartmentId : int
  - nextPositionId   : int
  --
  + loadAll() : void
  + saveAll() : void
  + getEmployees() : RecordCollection<EmployeeRecord>&
  + getDepartments() : RecordCollection<Department>&
  + getPositions() : RecordCollection<Position>&
  + addWorker(...) : int
  + addManager(...) : int
  + removeEmployee(employeeId : int) : bool
  + addDepartment(name : std::string, managerId : int) : int
  + removeDepartment(departmentId : int) : bool
  + addPosition(name : std::string, hoursPerWeek : int) : int
  + removePosition(positionId : int) : bool
  + findEmployees(filter : EmployeeSearchFilter) : std::vector<EmployeeRecord>
  + sortEmployees(key : EmployeeSortKey, descending : bool) : std::vector<EmployeeRecord>
  + calculateAverageSalaryForDepartment(departmentId : int) : double
  + canUndo() : bool
  + undoLastAction() : bool
  + getLastUndoDescription() : std::string
  --
  - loadEmployees() : void
  - loadDepartments() : void
  - loadPositions() : void
  - loadHireDates() : void
  - saveEmployees() : void
  - saveDepartments() : void
  - savePositions() : void
  - saveHireDates() : void
  - cloneEmployee(source : Employee) : std::shared_ptr<Employee>
  - findEmployeeRecord(employeeId : int) : EmployeeRecord*
  - findDepartment(departmentId : int) : Department*
  - findPosition(positionId : int) : Position*
  - registerEmployee(record : EmployeeRecord) : void
  - unregisterEmployee(employeeId : int) : void
  - ensureDepartmentContainsEmployee(departmentId : int, employeeId : int) : void
  - removeEmployeeFromDepartment(departmentId : int, employeeId : int) : void
  - pushUndo(undoAction : std::function<void()>, description : std::string) : void
  - generateEmployeeId() : int
  - generateDepartmentId() : int
  - generatePositionId() : int
}

' ===== Наследование =====
Employee --|> Person
Manager  --|> Employee
Worker   --|> Employee

' ===== Ассоциации (цельные стрелки без подписей) =====
DataManager --> EmployeeRecord
DataManager --> Department
DataManager --> Position
DataManager --> HireDate
DataManager --> UndoCommand

EmployeeRecord --> Employee
EmployeeRecord --> HireDate

Worker  --> Position
Department --> Employee
Manager  --> Employee
HireDate --> Employee

DataManager --> EmployeeSearchFilter
DataManager --> EmployeeSortKey
DataManager --> RecordCollectionT

@enduml


